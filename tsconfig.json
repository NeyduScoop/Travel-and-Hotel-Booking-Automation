{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "config/**/*.ts",
    "pages/**/*.ts",
    "components/**/*.ts",
    "data/**/*.ts",
    "data/**/*.json",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.ts",
    "reporters/**/*.ts",
    "playwright.config.ts"
  ]
}
