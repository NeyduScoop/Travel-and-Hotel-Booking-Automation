# Copy to .env and fill in locally. Never commit .env, and never put real values in this template.

# Environment: DEVTEST (default) | PREPROD | PRODUCTION
TEST_ENV=DEVTEST
HEADLESS=true

# Optional explicit base URL override (must belong to an approved Wakanow environment)
# BASE_URL=https://wkn-web-v4-devtest.azurewebsites.net

# Parallel workers (defaults: 4 locally, 2 on CI)
# WORKERS=4

# PRIME account (PRIME Flights / PRIME Hotels); tests are BLOCKED when absent
PRIME_EMAIL=
PRIME_PASSWORD=

# Affiliate account (affiliate login and booking); tests are BLOCKED when absent
AFFILIATE_EMAIL=
AFFILIATE_PASSWORD=

# Booking and payment safety. Both default to false and are never honoured on PRODUCTION.
# ALLOW_TEST_BOOKING_SUBMISSION=true lets tests press "Proceed to Pay" (creates a booking record) and
#   submit the unpaid routes: Pay at Bank, Bank Transfer Payment (Instant Ticketing), automated bank transfer.
# ALLOW_TEST_PAYMENT_AUTHENTICATION=true lets tests take the paid routes: Card (Paystack TEST mode:
#   Bank Authentication, or the test card below when card input is required) and Kalabash Wallet (PRIME only).
ALLOW_TEST_BOOKING_SUBMISSION=false
ALLOW_TEST_PAYMENT_AUTHENTICATION=false

# Test-mode card, used only when the Paystack TEST checkout requires card input. Never a real card.
TEST_CARD_NUMBER=
TEST_CARD_EXPIRY=
TEST_CARD_CVV=
TEST_CARD_PIN=
TEST_CARD_OTP=

# Kalabash Wallet test credentials (PRIME Flights / PRIME Hotels payments). KALABASH_* is preferred;
# PhoneNumber / password / pin are also accepted. The phone is the number after +234.
KALABASH_PHONE=
KALABASH_PASSWORD=
KALABASH_PIN=
